# Engine Files (Unreal Engine binary assets)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.udatasmith filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text

# Engine Files (Unity YAML assets - uses specific merge driver)
*.unity merge=unityyamlmerge text eol=lf
*.prefab merge=unityyamlmerge text eol=lf
*.asset merge=unityyamlmerge text eol=lf
*.mat merge=unityyamlmerge text eol=lf
*.anim merge=unityyamlmerge text eol=lf
*.meta filter=lfs diff=lfs merge=lfs -text

# C# sources (including ClangSharp-generated bindings) — force LF regardless of
# the cloning machine's core.autocrlf, so regenerated bindings never show up
# as line-ending-only diffs.
*.cs text=auto eol=lf

# Native/build sources — same reasoning as .cs above: force LF so a file
# touched from a different-OS toolchain never shows up as a whole-file diff.
*.h    text eol=lf
*.c    text eol=lf
*.hpp  text eol=lf
*.cpp  text eol=lf
*.zig  text eol=lf
*.zon  text eol=lf
*.slang text eol=lf

# Catch-all: any other text file not covered above still gets normalized,
# just without a forced eol (lets git auto-detect per the cloning machine).
* text=auto

# Other common large binaries
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
