[scene]
name    = "Main"
version = 1

# Directional light. AnimatedSun is a user subclass declared in Program.cs; resolved by FQN.
[[node]]
name = "Sun"
type = "AnimatedSun"
properties = { Direction = [0.5, 1.0, 0.5], Color = [1, 1, 1], Intensity = 10.0 }

# Single camera in the tree auto-activates as current.
[[node]]
name = "Camera"
type = "Camera"
transform = { position = [0, 5, 10] }
properties = { Fov = 60, Near = 0.1, Far = 1000 }

# Floor: material defined inline — one-off, no separate file needed.
[[node]]
name = "Floor"
type = "MeshRenderer"
transform = { scale = [10, 1, 10] }
properties.Mesh = "res://primitives/plane"
properties.Material = { base_color = [0.5, 0.5, 0.5, 1.0], metallic = 0.0, roughness = 0.8 }

# Caster: material loaded from a shared file — would let other scenes reuse the same red.
[[node]]
name = "Caster"
type = "MeshRenderer"
transform = { position = [0, 1, 0] }
properties = { Mesh = "res://primitives/cube", Material = "res://resources/red.material" }
