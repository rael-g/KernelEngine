[project]
name = "Pong"
default_scene = "Menu"

[logging]
console_level = "Warning"

[runtime]
[runtime.window]
width = 960
height = 540
title = "KernelEngine — Pong (2D)"
fullscreen = false

[runtime.renderer]
shader_path = "shaders"
vsync = true

[runtime.physics_2d]
gravity_x = 0.0
gravity_y = 0.0

[render]
clear_color_r = 0.04
clear_color_g = 0.04
clear_color_b = 0.08
clear_color_a = 1.0
ambient_light = [1.0, 1.0, 1.0]

[input.map.Pong.action.PaddleLeftMove]
type = "Axis1D"
bindings = [{ kind = "key_pair", negative = "S", positive = "W" }]

[input.map.Pong.action.PaddleRightMove]
type = "Axis1D"
bindings = [{ kind = "key_pair", negative = "Down", positive = "Up" }]

[input.map.Pong.action.Launch]
bindings = [{ kind = "key", key = "Space" }]

[input.map.Pong.action.Quit]
bindings = [{ kind = "key", key = "Escape" }]

[ke]
modules = ["KernelEngine.Kernel", "KernelEngine.Kernel.Logger", "KernelEngine.Kernel.ConsoleSink", "KernelEngine.Kernel.Input", "KernelEngine.Configuration", "KernelEngine.Framework.InputActions", "KernelEngine.Window.Glfw", "KernelEngine.Render.Bgfx", "KernelEngine.Physics.Box2D", "KernelEngine.Audio.MiniAudio", "KernelEngine.Framework.AudioFramework", "KernelEngine.Text.StbTrueType"]
