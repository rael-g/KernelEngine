[window]
width = 960
height = 540
title = "KernelEngine — Pong (C#)"
fullscreen = false

[target]
present_mode = "fifo"

[physics]
gravity_x = 0.0
gravity_y = 0.0

[frame]
clear_color = [0.04, 0.04, 0.08, 1.0]

[scene_files]
first_scene = "res://scenes/Menu.scene.toml"

[actions.map.Pong.action.PaddleLeftMove]
type = "Axis1D"
bindings = [{ kind = "key_pair", negative = "S", positive = "W" }]

[actions.map.Pong.action.PaddleRightMove]
type = "Axis1D"
bindings = [{ kind = "key_pair", negative = "Down", positive = "Up" }]

[actions.map.Pong.action.Launch]
bindings = [{ kind = "key", key = "Space" }]

[actions.map.Pong.action.Quit]
bindings = [{ kind = "key", key = "Escape" }]
