[scene]
name    = "Main"
version = 2

[[entity]]
name = "Ambient"
type = "AmbientLight"
[entity.components.ambient_light]
Color = [1.0, 1.0, 1.0]

[[entity]]
name = "Camera"
type = "Camera"
[entity.transform]
position = [0.0, 0.0, 10.0]
[entity.components.camera]
orthographic      = true
orthographic_size = 5.0
near_plane        = 0.1
far_plane         = 100.0

# Walls — each entity composes Wall.scene (scale [16, 0.5, 1] from subscene).
[[entity]]
name  = "WallTop"
scene = "res://scenes/Wall.scene"
[entity.transform]
position = [0.0, 4.5, 0.0]

[[entity]]
name  = "WallBottom"
scene = "res://scenes/Wall.scene"
[entity.transform]
position = [0.0, -4.5, 0.0]

# Paddles — position and move_action come from here; type from Paddle.scene.
[[entity]]
name  = "PaddleLeft"
scene = "res://scenes/Paddle.scene"
[entity.transform]
position = [-7.5, 0.0, 0.0]
[entity.components.paddle]
move_action = "PaddleLeftMove"

[[entity]]
name  = "PaddleRight"
scene = "res://scenes/Paddle.scene"
[entity.transform]
position = [7.5, 0.0, 0.0]
[entity.components.paddle]
move_action = "PaddleRightMove"

[[entity]]
name  = "Ball"
scene = "res://scenes/Ball.scene"

[[entity]]
name = "Scoreboard"
type = "Pong.Scoreboard"
[entity.properties]
FontPath = ""
FontSize = 56.0

[[entity]]
name = "PhysicsDriver"
type = "Pong.PhysicsDriver"
