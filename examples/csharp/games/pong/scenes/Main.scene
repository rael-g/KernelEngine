[scene]
name    = "Main"
version = 2

[[entity]]
name = "Ambient"
type = "AmbientLight"
[entity.properties]
Color = [1.0, 1.0, 1.0]

[[entity]]
name = "Camera"
type = "Camera"
[entity.properties]
Orthographic     = true
OrthographicSize = 5.0
Near             = 0.1
Far              = 100.0
Position         = [0.0, 0.0, 10.0]

# Walls — each entity composes Wall.scene; the outer Position wins, the
# subscene's Scale = [16, 0.5, 1] passes through as the default.
[[entity]]
name  = "WallTop"
scene = "res://scenes/Wall.scene"
[entity.properties]
Position = [0.0,  4.5]

[[entity]]
name  = "WallBottom"
scene = "res://scenes/Wall.scene"
[entity.properties]
Position = [0.0, -4.5]

# Paddles — Paddle.scene defines the type; per-instance Position +
# MoveAction come from here.
[[entity]]
name  = "PaddleLeft"
scene = "res://scenes/Paddle.scene"
[entity.properties]
Position   = [-7.5, 0.0]
MoveAction = "PaddleLeftMove"

[[entity]]
name  = "PaddleRight"
scene = "res://scenes/Paddle.scene"
[entity.properties]
Position   = [7.5, 0.0]
MoveAction = "PaddleRightMove"

[[entity]]
name  = "Ball"
scene = "res://scenes/Ball.scene"

[[entity]]
name = "Scoreboard"
type = "Pong.Scoreboard"
[entity.properties]
FontPath = ""
FontSize = 56.0

[[entity]]
name = "PhysicsDriver"
type = "Pong.PhysicsDriver"
