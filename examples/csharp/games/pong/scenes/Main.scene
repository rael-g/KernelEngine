[scene]
name    = "Main"
version = 2

# Full-bright scene-wide ambient so unlit-feeling materials land at face value.
[[entity]]
name = "Ambient"
type = "AmbientLight"
[entity.properties]
Color = [1.0, 1.0, 1.0]

# 2D orthographic camera looking down -Z from the +Z hemisphere.
[[entity]]
name = "Camera"
type = "Camera"
[entity.properties]
Orthographic     = true
OrthographicSize = 5.0
Near             = 0.1
Far              = 100.0
Position         = [0.0, 0.0, 10.0]

# Top + bottom walls (static bodies + dark quads). Wall script picks the
# half-extents from this transform's Scale.
[[entity]]
name = "WallTop"
type = "Pong.Wall"
[entity.properties]
Position = [0.0,  4.5]
Scale    = [16.0, 0.5, 1.0]

[[entity]]
name = "WallBottom"
type = "Pong.Wall"
[entity.properties]
Position = [0.0, -4.5]
Scale    = [16.0, 0.5, 1.0]

# Paddles — MoveAction is read from actions.input and matched to PongAction
# members by name.
[[entity]]
name = "PaddleLeft"
type = "Pong.Paddle"
[entity.properties]
Position   = [-7.5, 0.0]
MoveAction = "PaddleLeftMove"

[[entity]]
name = "PaddleRight"
type = "Pong.Paddle"
[entity.properties]
Position   = [7.5, 0.0]
MoveAction = "PaddleRightMove"

# Ball — spawns at origin; the script finds the Scoreboard by name on the
# first frame and from there drives scoring + sound effects.
[[entity]]
name = "Ball"
type = "Pong.Ball"

# Scoreboard — script creates 3 child labels in OnBind, using its own font
# loaded from FontPath. Empty FontPath = the OS's default Arial.
[[entity]]
name = "Scoreboard"
type = "Pong.Scoreboard"
[entity.properties]
FontPath = ""
FontSize = 56.0

# Drives the Box2D simulation. Registered LAST so it ticks AFTER paddles +
# ball have set their velocities for this frame.
[[entity]]
name = "PhysicsDriver"
type = "Pong.PhysicsDriver"
