[scene]
name    = "Paddle"
version = 2

[[entity]]
name = "Root"
type = "Pong.Paddle"

[[entity]]
name   = "Shape"
parent = "Root"
type   = "CollisionShape2D"
[entity.properties]
ShapeKind        = "rectangle"
ShapeHalfExtents = [0.15, 0.9]
Restitution      = 1.0

[[entity]]
name   = "Visual"
parent = "Root"
type   = "Sprite2D"
[entity.transform]
scale = [0.3, 1.8, 1.0]
[entity.components.mesh]
mesh      = "quad"
color     = [0.95, 0.95, 0.95, 1.0]
roughness = 1.0
