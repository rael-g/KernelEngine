[scene]
name    = "Ball"
version = 2

[[entity]]
name = "Root"
type = "Pong.Ball"

[[entity]]
name   = "Shape"
parent = "Root"
type   = "CollisionShape2D"
[entity.properties]
ShapeKind        = "rectangle"
ShapeHalfExtents = [0.18, 0.18]
Restitution      = 1.0
Friction         = 0.0

[[entity]]
name   = "Visual"
parent = "Root"
type   = "Sprite2D"
[entity.transform]
scale = [0.36, 0.36, 1.0]
[entity.components.mesh]
mesh      = "quad"
color     = [0.95, 0.95, 0.95, 1.0]
roughness = 1.0

[[entity]]
name   = "HitSound"
parent = "Root"
type   = "AudioPlayer"
[entity.properties]
Path   = "assets/sounds/hit.wav"
Volume = 0.5

[[entity]]
name   = "ScoreSound"
parent = "Root"
type   = "AudioPlayer"
[entity.properties]
Path   = "assets/sounds/score.wav"
Volume = 0.6
