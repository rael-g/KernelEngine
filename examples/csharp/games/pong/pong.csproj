<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Pong</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Project">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="actions.input">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Also handed to the generator, which emits one type per scene so
         LoadScene<T> can name them; it puts them under RootNamespace.Scenes,
         which it can only read if the property is made compiler-visible. -->
    <CompilerVisibleProperty Include="RootNamespace" />
    <AdditionalFiles Include="scenes/**/*.scene.toml" />
    <Content Include="scenes/**/*.scene.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\csharp\configuration\KernelEngine.Configuration\KernelEngine.Configuration.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\ecs\KernelEngine.Ecs.Flecs\KernelEngine.Ecs.Flecs.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\runtime\KernelEngine.Runtime\KernelEngine.Runtime.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\scheduler\KernelEngine.Scheduler.Enki\KernelEngine.Scheduler.Enki.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\window\KernelEngine.Window.Glfw\KernelEngine.Window.Glfw.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\render\KernelEngine.Render.Webgpu\KernelEngine.Render.Webgpu.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\framework\KernelEngine.Framework\KernelEngine.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\physics\KernelEngine.Physics.Box2D\KernelEngine.Physics.Box2D.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\audio\KernelEngine.Audio.MiniAudio\KernelEngine.Audio.MiniAudio.csproj" />
    <ProjectReference Include="..\..\..\..\src\csharp\text\KernelEngine.Text.StbTrueType\KernelEngine.Text.StbTrueType.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\csharp\generators\KernelEngine.SourceGenerators\KernelEngine.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

