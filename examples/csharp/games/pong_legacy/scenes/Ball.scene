[scene]
name    = "Ball"
version = 1

[[entity]]
name = "Root"
[entity.script]
language = "csharp"
type     = "Pong.Ball"

[[entity]]
name   = "Shape"
parent = "Root"
[entity.script]
language = "csharp"
type     = "CollisionShape2D"
[entity.properties]
ShapeKind        = "rectangle"
ShapeHalfExtents = [0.18, 0.18]
Restitution      = 1.0
Friction         = 0.0

[[entity]]
name   = "Visual"
parent = "Root"
[entity.script]
language = "csharp"
type     = "Sprite2D"
[entity.properties]
Mesh              = "res://primitives/quad"
MaterialBaseColor = [0.95, 0.95, 0.95, 1.0]
Size              = [0.36, 0.36]

[[entity]]
name   = "HitSound"
parent = "Root"
[entity.script]
language = "csharp"
type     = "AudioPlayer"
[entity.properties]
Path   = "assets/sounds/hit.wav"
Volume = 0.5

[[entity]]
name   = "ScoreSound"
parent = "Root"
[entity.script]
language = "csharp"
type     = "AudioPlayer"
[entity.properties]
Path   = "assets/sounds/score.wav"
Volume = 0.6
