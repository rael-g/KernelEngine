set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_ENV_PASSTHROUGH_UNTRACKED PATH ZIG_LOCAL_CACHE_DIR)

set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/zig-linux-toolchain.cmake")

if(PORT STREQUAL "flecs")
  list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS "-DCMAKE_PROJECT_flecs_INCLUDE=${CMAKE_CURRENT_LIST_DIR}/flecs-checks.cmake")
endif()
