{
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "*/toc.yml",
          "guides/**.md",
          "architecture/**.md",
          "conventions/**.md",
          "formats/**.md"
        ]
      },
      {
        "src": "../build/native/docs",
        "files": ["engine/**", "kabic/**"],
        "dest": "reference"
      }
    ],
    "output": "../build/docs-site",
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appTitle": "KernelEngine",
      "_appName": "KernelEngine",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
