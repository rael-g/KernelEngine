<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="build/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-rael-g" value="https://nuget.pkg.github.com/rael-g/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github-rael-g">
      <package pattern="Kabic.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github-rael-g>
      <add key="Username" value="rael-g" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-rael-g>
  </packageSourceCredentials>
</configuration>
