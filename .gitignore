# Everything the build produces or fetches lives under one directory.
# build/native/   install prefix (bin, lib, gen)
# build/tools/    fetched toolchains: vcpkg, slangc, wgpu-native
# build/vcpkg-installed/  vcpkg's own install root, per triplet
# build/zig-cache/        one cache for the root build and every sub-build
/build/

# Zig writes these when a plugin's build.zig is invoked standalone from its own
# directory, which bypasses the root build's --cache-dir.
.zig-cache/
zig-out/
zig-pkg/

# .NET
[Bb]in/
[Oo]bj/
TestResults/
*.csproj.lscache
packages/
node_modules/

# Coverage and profiling
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov

# Native build leftovers, when a tool writes beside the source instead of into build/
*.o
*.obj
*.exe
*.dll
*.lib
*.so
*.a
*.pdb
*.ilk
*.exp
*.idb
*.iobj
*.ipdb
*.manifest
*.res
*.bin
!assets/*.bin

# External projects copied in for study — never engine source
/reference/

# Editors and IDEs
.vscode/
.idea/
*.sln.DotSettings
*.user
*.csproj.user
*.swp
*.swo
*.sublime-project
*.sublime-workspace
tags
TAGS
cscope.*

# Agent tooling: session scratch, never part of the project
.claude/
.aider*

# Planning, logs, tasks and TODOs are not versioned — see docs/conventions/docs.md
/docs/kanban/
/.docs-lixeira/

# OS
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
*.bak
*.orig
*.pid

# Clang resource-dir headers that kabic fetches
/.cache/
