FROM ke-ci

ARG APT_SNAPSHOT=20261001T000000Z
ARG WINE_VERSION=11.0.0.0~noble-1
ARG WINEHQ_KEY_SHA256=d965d646defe94b3dfba6d5b4406900ac6c81065428bf9d9303ad7a72ee8d1b8
RUN dpkg --add-architecture i386 \
    && mkdir -pm755 /etc/apt/keyrings \
    && curl -fsSL -o /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
    && echo "${WINEHQ_KEY_SHA256}  /etc/apt/keyrings/winehq-archive.key" | sha256sum -c - \
    && curl -fsSL -o /etc/apt/sources.list.d/winehq-noble.sources https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources \
    && apt-get update --snapshot "${APT_SNAPSHOT}" \
    && apt-get install -y --install-recommends --snapshot "${APT_SNAPSHOT}" \
        "winehq-stable=${WINE_VERSION}" "wine-stable=${WINE_VERSION}" \
        "wine-stable-amd64=${WINE_VERSION}" "wine-stable-i386=${WINE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ARG DOTNET_WINDOWS_SDK_VERSION=10.0.401
ARG DOTNET_WINDOWS_SDK_SHA512=24b670ad3d923bfcf47df6c3b034152398b42f6dbc388e10d783aee1cfb5e5817d399fc0ae2a12cfa822a55e61d34830ccb15c50ef6efee437ab874bb7c79430
RUN curl -fsSL -o /tmp/dotnet-windows.zip "https://builds.dotnet.microsoft.com/dotnet/Sdk/${DOTNET_WINDOWS_SDK_VERSION}/dotnet-sdk-${DOTNET_WINDOWS_SDK_VERSION}-win-x64.zip" \
    && echo "${DOTNET_WINDOWS_SDK_SHA512}  /tmp/dotnet-windows.zip" | sha512sum -c - \
    && unzip -q /tmp/dotnet-windows.zip -d /opt/dotnet-windows \
    && rm /tmp/dotnet-windows.zip
ENV DOTNET_WINDOWS_ROOT=/opt/dotnet-windows

RUN wine wineboot --init && wineserver --wait
