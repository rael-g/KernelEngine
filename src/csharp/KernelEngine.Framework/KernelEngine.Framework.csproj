<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTarget>ke_framework</NativeTarget>
  </PropertyGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <!-- Framework concept plugins live in their own native libs; pull them in. -->
    <None Include="$(NativeFinalDir)\ke_node_type_registry.$(NativeExt)" Condition="Exists('$(NativeFinalDir)\ke_node_type_registry.$(NativeExt)')">
      <Link>ke_node_type_registry.$(NativeExt)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KernelEngine.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework is the binding+sugar layer over src/c/framework. It owns its own
         native bindings (Native/Generated/Framework/) and the concrete wrappers for
         framework concepts (NodeTypeRegistry, SceneLoader, InputActions, ResourceCache,
         SceneTree). The old "knows only Abstractions" rule was deprecated by the
         2026-06-02 kernel/framework split — see docs/Kanban.md Tier S refinement. -->
    <ProjectReference Include="../KernelEngine.Kernel.Abstractions/KernelEngine.Kernel.Abstractions.csproj" />
    <ProjectReference Include="../KernelEngine.Kernel/KernelEngine.Kernel.csproj" />
    <ProjectReference Include="../KernelEngine.Configuration/KernelEngine.Configuration.csproj" />
  </ItemGroup>

</Project>
