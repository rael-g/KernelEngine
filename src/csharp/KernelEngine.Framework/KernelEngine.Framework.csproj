<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- New runtime-native framework. Built example-by-example during R6
         migration; copies from .Legacy only what's needed, marks native
         candidates along the way. NO unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KernelEngine.Framework</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel.Abstractions\KernelEngine.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
    <ProjectReference Include="..\KernelEngine.Runtime\KernelEngine.Runtime.csproj" />
    <ProjectReference Include="..\KernelEngine.Ecs.Flecs\KernelEngine.Ecs.Flecs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

</Project>
