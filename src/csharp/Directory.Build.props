<Project>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../build/artifacts'))</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>Kernel Engine Team</Authors>
    <Company>Kernel Engine</Company>
    <Product>Kernel Engine</Product>
    <Description>Native performance kernel with C# expressiveness.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/your-repo/KernelEngine</RepositoryUrl>
    <Version>0.1.0-alpha</Version>
    <IncludeContentInPack>true</IncludeContentInPack>

    <UsePackageReferences Condition="'$(UsePackageReferences)' == ''">false</UsePackageReferences>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Native'))">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

</Project>
