    {
      "name": "ke_image_loader",
      "doc": "Decodes 2D images (PNG/JPG/...) from disk into RGBA8. Async dispatch is the caller\u0027s responsibility.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "load_image",
          "returns": "ke_result",
          "tags": [],
          "doc": "Loads an image from path into a newly allocated ke_texture_data (RGBA8).",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null path or out_image; KE_RESULT_NOT_FOUND when the file cannot be decoded, its reason logged; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": "Image file path to decode."
            },
            {
              "name": "out_image",
              "type": "ke_texture_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the image, which the caller owns and releases with free_image; NULL on failure."
            }
          ],
          "receiver": "struct ke_image_loader *"
        },
        {
          "name": "free_image",
          "returns": "void",
          "tags": [
            "releases:Image"
          ],
          "doc": "Frees a ke_texture_data previously returned by load_image. A null data is ignored.",
