  "vtables": [
    {
      "name": "ke_asset_loader",
      "doc": "Loads 3D assets into ke_model_data. Async dispatch is the caller\u0027s concern.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "load_model",
          "returns": "ke_result",
          "tags": [],
          "doc": "Loads a 3D model from path into a newly allocated ke_model_data.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null path or out_model; KE_RESULT_NOT_FOUND when the importer cannot read the file, its reason logged; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": "Absolute or relative file path (.gltf, .glb, .obj, .fbx, \u2026)."
            },
            {
              "name": "out_model",
              "type": "ke_model_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the model, which the caller owns and releases with free_model; NULL on failure."
            }
          ],
          "receiver": "struct ke_asset_loader *"
        },
        {
          "name": "free_model",
          "returns": "void",
          "tags": [
            "releases:Model"
          ],
          "doc": "Frees a ke_model_data previously returned by load_model. The model must be given back to the same loader that produced it. A foreign or hand-built ke_model_data is not a valid argument. A null data is ignored.",
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_model_data *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_asset_loader *"
        }
      ]
    },
