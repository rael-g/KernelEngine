          ]
        },
        {
          "name": "free_model",
          "returns": "void",
          "tags": [],
          "doc": "Frees a ke_model_data previously returned by load_model or the async variant. The model must be given back to the same loader that produced it. A loader owns its memory, so a foreign or hand-built ke_model_data is not a valid argument. A null is ignored.",
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_model_data *",
              "tags": [],
              "doc": null
            }
