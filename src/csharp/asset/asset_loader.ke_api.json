      "slots": [
        {
          "name": "load_model",
          "returns": "ke_result",
          "tags": [],
          "doc": "Loads a 3D model from path into a newly allocated ke_model_data.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null path or out_model; KE_RESULT_NOT_FOUND when the importer cannot read the file, its reason logged; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": "Absolute or relative file path (.gltf, .glb, .obj, .fbx, \u2026)."
            },
            {
              "name": "out_model",
              "type": "ke_model_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the model, which the caller owns and releases with free_model; NULL on failure."
            }
          ],
          "receiver": "struct ke_asset_loader *"
        },
        {
          "name": "free_model",
          "returns": "void",
          "tags": [
            "releases:Model"
          ],
          "doc": "Frees a ke_model_data previously returned by load_model or the async variant. The model must be given back to the same loader that produced it. A foreign or hand-built ke_model_data is not a valid argument. A null data is ignored.",
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_model_data *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_asset_loader *"
        },
        {
          "name": "load_model_async",
          "returns": "ke_task *",
          "tags": [],
          "doc": "Asynchronously loads a 3D model, calling on_complete on a task pool thread once the load has finished or failed.",
          "return_doc": "A ke_task* that can be waited on.",
          "params": [
            {
              "name": "task_pool",
              "type": "ke_task_pool *",
              "tags": [
                "provider"
              ],
              "doc": "Non-null task pool."
            },
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": "File path (copied internally; caller may free after return)."
            },
            {
              "name": "on_complete",
              "type": "ke_load_model_complete_func",
              "tags": [
                "completion:user_data"
              ],
              "doc": "Callback invoked with the result; must not be NULL."
            },
            {
              "name": "user_data",
              "type": "void *",
              "tags": [],
              "doc": "Forwarded unchanged to on_complete."
            }
          ],
          "receiver": "struct ke_asset_loader *"
        }
      ]
    },
