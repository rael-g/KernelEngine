  "vtables": [
    {
      "name": "ke_task_pool",
      "doc": "Dispatches work to a native thread pool.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "dispatch",
          "returns": "ke_result",
          "tags": [],
          "doc": "Schedules a task, which the caller releases by waiting on it.",
          "return_doc": "KE_OK, KE_RESULT_INVALID_ARGUMENT for a null func or out_task, KE_RESULT_OUT_OF_MEMORY, or KE_RESULT_NOT_SUPPORTED when the pool does not accept the calling thread.",
          "params": [
            {
              "name": "func",
              "type": "ke_task_func",
              "tags": [
                "raw_callback",
                "closure:data"
              ],
              "doc": "Entry point invoked on a worker thread."
            },
            {
              "name": "data",
              "type": "void *",
              "tags": [
                "borrowed"
              ],
              "doc": "Opaque context passed to func unchanged."
            },
            {
              "name": "out_task",
              "type": "ke_task **",
              "tags": [
                "out"
              ],
              "doc": "Receives the task; null on failure."
            }
          ],
          "receiver": "struct ke_task_pool *"
        },
        {
          "name": "dispatch_on_complete",
          "returns": "ke_result",
          "tags": [],
          "doc": "Schedules a task and a completion callback run once it finishes.",
          "return_doc": "KE_OK, KE_RESULT_INVALID_ARGUMENT for a null func or out_task, KE_RESULT_OUT_OF_MEMORY, or KE_RESULT_NOT_SUPPORTED when the pool does not accept the calling thread.",
          "params": [
            {
              "name": "func",
              "type": "ke_task_func",
              "tags": [
                "raw_callback",
                "closure:data"
              ],
              "doc": "Entry point invoked on a worker thread."
            },
            {
              "name": "data",
              "type": "void *",
              "tags": [
                "borrowed"
              ],
              "doc": "Opaque context passed to func unchanged."
            },
            {
              "name": "on_complete",
              "type": "ke_task_on_complete_func",
              "tags": [
                "raw_callback",
                "closure:user_data"
              ],
              "doc": "Invoked after func returns."
            },
            {
              "name": "user_data",
              "type": "void *",
              "tags": [
                "borrowed"
              ],
              "doc": "Opaque context passed to on_complete unchanged."
            },
            {
              "name": "out_task",
              "type": "ke_task **",
              "tags": [
                "out"
              ],
              "doc": "Receives the task; null on failure."
            }
          ],
          "receiver": "struct ke_task_pool *"
        },
        {
          "name": "wait",
          "returns": "ke_result",
          "tags": [],
          "doc": "Blocks the calling thread until the task completes, releases the task, and returns what its body returned. Every task a dispatch slot returns is waited on exactly once: afterwards the pointer is invalid for wait and is_completed alike, and a task never waited on is never released and reports its failure nowhere.",
          "return_doc": "What the task body returned, or KE_RESULT_INVALID_ARGUMENT for a null task.",
          "params": [
            {
              "name": "task",
              "type": "ke_task *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_task_pool *"
        },
        {
          "name": "is_completed",
          "returns": "_Bool",
          "tags": [],
          "doc": "Returns true if the task has finished. Valid only before the task is waited on.",
          "return_doc": null,
          "params": [
            {
              "name": "task",
              "type": "ke_task *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_task_pool *"
        },
        {
          "name": "get_num_workers",
          "returns": "uint32_t",
          "tags": [],
          "doc": "Returns the number of worker threads in the pool.",
          "return_doc": null,
          "params": [],
          "receiver": "struct ke_task_pool *"
        }
      ],
      "external": true
    },
