          "returns": "ke_task *",
          "tags": [],
          "doc": "Asynchronously loads a 3D model using Returns a ke_task* that can be waited on; is invoked on the scheduler thread when the load finishes (or fails).",
          "return_doc": null,
          "params": [
            {
              "name": "scheduler",
              "type": "ke_scheduler *",
