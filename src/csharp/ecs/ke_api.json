    {
      "name": "ke_ecs_commands",
      "doc": "A queue of structural mutations. Every operation records its intent and returns; none changes the world while it runs. The queue is applied, in the order the operations were recorded, by whoever owns it, and an operation\u0027s effect is not observable before then. A caller needing a change visible at once uses ke_ecs, which mutates immediately. Recording is what makes these operations callable from code that must not touch the world: a system body running beside other systems records, and the runtime applies every body\u0027s queue while nothing else runs. An implementation that cannot accept an operation fails it with the reason in \u0060out_error\u0060 and leaves the queue unchanged.",
      "tags": [],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "spawn",
          "returns": "ke_entity",
          "tags": [],
          "doc": "Records the creation of an entity and answers the id it will have. The id can be named by later operations of this queue, and by any caller, at once; the entity itself exists once the queue is applied.",
          "return_doc": "KE_ENTITY_INVALID when the operation could not be recorded.",
          "params": [
            {
              "name": "out_error",
              "type": "ke_error **",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "ke_ecs_commands *"
        },
        {
          "name": "attach",
          "returns": "_Bool",
          "tags": [],
          "doc": "Records giving \u0060entity\u0060 the component \u0060cid\u0060, initialised from \u0060size\u0060 bytes of \u0060data\u0060. The bytes are copied, so the caller\u0027s buffer need not outlive the call. \u0060size\u0060 must equal the registered size of \u0060cid\u0060, or be 0 to attach the component without copying bytes into it.",
          "return_doc": "false when the operation could not be recorded.",
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            },
            {
              "name": "cid",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            },
            {
              "name": "data",
              "type": "const void *",
              "tags": [
                "bytes_of:size"
              ],
              "doc": null
            },
            {
              "name": "size",
              "type": "size_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_error",
              "type": "ke_error **",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "ke_ecs_commands *"
        },
        {
          "name": "detach",
          "returns": "_Bool",
          "tags": [],
          "doc": "Records removing component \u0060cid\u0060 from \u0060entity\u0060.",
          "return_doc": "false when the operation could not be recorded.",
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            },
            {
              "name": "cid",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_error",
