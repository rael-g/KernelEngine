          "name": "submit",
          "returns": "ke_result",
          "tags": [],
          "doc": "Runs fn once every dependency finished. Callable from any thread.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null fn, out_completion, or a null dependency; KE_RESULT_OUT_OF_MEMORY, also when the queue for other threads is full.",
