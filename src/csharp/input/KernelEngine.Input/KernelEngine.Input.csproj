<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <NativeDep Include="ke_input_default" />
  </ItemGroup>

  <Import Project="../../NativeDependencies.targets" />

  <ItemGroup>
    <!-- ke_logger is excluded from generation but ClangSharp emits a forward stub that would shadow
         the KernelEngine.Kernel.Native.ke_logger type. Exclude it; the using directive resolves the type. -->
    <Compile Remove="Native/Generated/InputDefault/ke_logger.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
