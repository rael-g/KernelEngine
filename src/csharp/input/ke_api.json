          "receiver": "struct ke_input *"
        },
        {
          "name": "drain_events",
          "returns": "uint32_t",
          "tags": [
            "raw"
          ],
          "doc": "Drains pending discrete events and clears the queue. Events beyond the buffer capacity are dropped. Must run on the same thread as the sinks below.",
          "return_doc": "Number of events written.",
          "params": [
            {
              "name": "out_buf",
              "type": "ke_input_event *",
              "tags": [
                "out",
                "array_of:capacity"
              ],
              "doc": "Receives the drained events."
            },
            {
              "name": "capacity",
              "type": "uint32_t",
              "tags": [],
              "doc": "Maximum number of events to write."
            }
          ],
          "receiver": "struct ke_input *"
        },
