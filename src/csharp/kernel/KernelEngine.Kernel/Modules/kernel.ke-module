# Each .ke-module declares one engine module the `ke` CLI can add to a Project. Plugin
# authors ship these files alongside their csproj (or in a NuGet package's tools/ folder)
# so `ke add module <id>` can wire it up without hard-coded CLI catalogs.
#
# Fields:
#   id          (string)       — globally unique; convention "<csproj>" for single-module
#                                packages, "<csproj>.<suffix>" when one csproj exposes
#                                several modules.
#   using       (string)       — namespace inserted at the top of Program.cs.
#   extension   (string)       — IServiceCollection extension method name appended to the
#                                services chain.
#   csproj-ref  (string)       — repo-relative path to the csproj that ships this module.
#                                Resolved against the engine root the CLI was launched
#                                under; once we ship NuGet packages, this becomes
#                                "<package>" + an inferred version.
#   depends-on  (string array) — other module ids this one must follow in the chain.
#                                CLI does a topological sort before generating Program.cs.

id          = "KernelEngine.Kernel"
using       = "KernelEngine.Kernel"
extension   = "AddKernel"
csproj-ref  = "src/csharp/KernelEngine.Kernel/KernelEngine.Kernel.csproj"
depends-on  = []
