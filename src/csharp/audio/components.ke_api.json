    {
      "name": "ke_audio_player_component",
      "doc": "A single audio clip, loaded from the path the scene declares and played on demand. Each node holds its own clip: two AudioPlayer children under the same parent are two clips, told apart by node name. The clip is loaded on the first update that sees the component and unloaded on the first update in which the entity no longer holds it.",
      "tags": [
        "table",
        "node:AudioPlayer",
        "base:Node3D"
      ],
      "fields": [
        {
          "name": "path",
          "type": "char[256]",
          "tags": [],
          "doc": "Path to the audio file, resolved against the project\u0027s base directory."
        },
        {
          "name": "volume",
          "type": "float",
          "tags": [
            "default:1"
          ],
          "doc": "Linear gain, 0..1."
        },
        {
          "name": "play_requested",
          "type": "bool",
          "tags": [],
          "doc": "Set to play the clip once from its start at volume; the next update plays it and clears the flag. A clip that is not loaded clears it without playing."
        },
        {
          "name": "sound",
          "type": "ke_audio_sound",
          "tags": [
            "internal"
          ],
          "doc": "The loaded clip, assigned when the component is reconciled. Callers do not write it."
        }
      ]
    }
