    {
      "name": "ke_sound_component",
      "doc": "One playback of an audio clip. The sound plays while playing is set: setting it starts the clip from its beginning, clearing it stops the clip, and the clip reaching its end clears it. Two sounds of the same clip play at once, each on its own. The clip is loaded on the first update that sees the component and released on the first update in which the entity no longer holds it.",
      "tags": [
        "table",
        "node:Sound",
        "base:Node3D"
      ],
      "fields": [
        {
          "name": "path",
          "type": "char[256]",
          "tags": [],
          "doc": "Path to the audio file, resolved against the project\u0027s base directory."
        },
        {
          "name": "volume",
          "type": "float",
          "tags": [
            "default:1"
          ],
          "doc": "Linear gain, 0..1."
        },
        {
          "name": "pitch",
          "type": "float",
          "tags": [
            "default:1"
          ],
          "doc": "Playback rate; 1 is the recorded pitch."
        },
        {
          "name": "loop",
          "type": "bool",
          "tags": [],
          "doc": "Plays the clip again from its beginning each time it ends, until playing is cleared."
        },
        {
          "name": "playing",
          "type": "bool",
          "tags": [],
          "doc": null
        },
        {
          "name": "release",
          "type": "ke_sound_release",
          "tags": [],
          "doc": "What happens to the entity when the clip ends."
        },
        {
          "name": "clip",
          "type": "ke_audio_sound",
          "tags": [
            "internal"
          ],
          "doc": "The loaded clip, assigned when the component is reconciled. Callers do not write it."
        },
        {
          "name": "voice",
          "type": "ke_audio_voice",
          "tags": [
            "internal"
          ],
          "doc": "The playback in progress, assigned while the clip plays. Callers do not write it."
        }
      ]
    }
