    {
      "name": "ke_audio",
      "doc": "Audio playback. Every slot is safe to call from a system body.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "load_sound",
          "returns": "ke_result",
          "tags": [],
          "doc": "Loads a sound for repeated playback; the backend autodetects the format.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null path or out_sound; KE_RESULT_NOT_FOUND when the file cannot be opened; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "borrowed",
                "utf8"
              ],
              "doc": "The audio file, read through the io the backend was created with."
            },
            {
              "name": "out_sound",
              "type": "ke_audio_sound *",
              "tags": [
                "out"
              ],
              "doc": "Receives the sound; KE_AUDIO_SOUND_INVALID on failure."
            }
          ],
          "receiver": "struct ke_audio *"
        },
        {
          "name": "unload_sound",
          "returns": "void",
          "tags": [],
          "doc": "Releases a previously loaded sound; safe on KE_AUDIO_SOUND_INVALID.",
          "return_doc": null,
          "params": [
            {
              "name": "sound",
              "type": "ke_audio_sound",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_audio *"
        },
        {
          "name": "play",
          "returns": "ke_result",
          "tags": [],
          "doc": "Plays a sound, restarting it from the beginning if already playing.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for KE_AUDIO_SOUND_INVALID; KE_RESULT_NOT_FOUND for a sound that is not loaded; KE_RESULT_GENERAL when the backend cannot start it.",
          "params": [
            {
              "name": "sound",
              "type": "ke_audio_sound",
              "tags": [],
              "doc": null
            },
            {
              "name": "volume",
              "type": "float",
              "tags": [],
              "doc": "Playback volume in 0..1."
            },
            {
              "name": "loop",
              "type": "bool",
              "tags": [],
              "doc": "Non-zero to restart the sound when it ends."
            }
          ],
          "receiver": "struct ke_audio *"
        },
        {
          "name": "stop",
