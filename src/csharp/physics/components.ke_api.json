    {
      "name": "ke_body2d_component",
      "doc": "A 2D rigid body. Pose and motion are stored here because the simulation owns them between ticks; the node\u0027s own transform2d is written back from this component each tick by the physics plugin\u0027s own system, so what a script reads and what the hierarchy composes are the same two dimensions the body moves in. The same system creates and destroys the underlying body by reconciling this component against the world, so the entity is the identity and a script never acquires, threads, or releases a handle.",
      "tags": [
        "node:Body2D",
        "base:Node2D"
      ],
      "fields": [
        {
          "name": "type",
          "type": "ke_body_type_2d",
          "tags": [],
          "doc": null
        },
        {
          "name": "position",
          "type": "ke_vec2",
          "tags": [],
          "doc": null
        },
        {
          "name": "angle",
          "type": "float",
          "tags": [],
          "doc": "Radians, CCW positive."
        },
        {
          "name": "velocity",
          "type": "ke_vec2",
          "tags": [],
          "doc": null
        },
        {
          "name": "angular_velocity",
          "type": "float",
          "tags": [],
          "doc": "Radians per second, CCW positive."
        },
        {
          "name": "gravity_scale",
          "type": "float",
          "tags": [
            "default:1"
          ],
          "doc": null
        },
        {
          "name": "fixed_rotation",
          "type": "_Bool",
          "tags": [],
          "doc": "Keeps the body\u0027s angle fixed against every torque, including contacts. What anything that must stay upright sets \u2014 characters, projectiles."
        },
        {
          "name": "body",
          "type": "ke_body_2d",
          "tags": [
            "idiom"
          ],
          "doc": "The plugin\u0027s body for this entity, assigned when it reconciles the component. Authoring it would name a body the world does not own."
        }
      ]
    },
    {
      "name": "ke_collider2d_component",
      "doc": "One collision fixture, attached to the nearest ancestor that carries a ke_body2d_component. Named for what it holds \u2014 a kind, extents, density, friction, restitution \u2014 rather than for a shape it is not. It is a node of its own rather than a field on the body because it has an offset the body does not, and because a body may carry several. The physics plugin\u0027s own system attaches the fixture by reconciling this component against the hierarchy, so a script never names a body.",
      "tags": [
        "node:Collider2D",
        "base:Node2D"
      ],
      "fields": [
        {
          "name": "kind",
          "type": "ke_shape_kind_2d",
          "tags": [],
          "doc": null
        },
        {
          "name": "half_extents",
          "type": "ke_vec2",
          "tags": [
            "default:0.5 0.5"
          ],
          "doc": null
        },
        {
          "name": "radius",
          "type": "float",
          "tags": [
            "default:0.5"
          ],
          "doc": null
        },
        {
          "name": "density",
          "type": "float",
          "tags": [
            "default:1"
          ],
          "doc": null
        },
        {
          "name": "friction",
          "type": "float",
          "tags": [
            "default:0.3"
          ],
          "doc": null
        },
        {
          "name": "restitution",
          "type": "float",
          "tags": [],
          "doc": "Bounciness. 0 absorbs the impact, 1 returns all of it."
        },
        {
          "name": "layer",
          "type": "uint32_t",
          "tags": [
            "default:1"
          ],
          "doc": null
        },
        {
          "name": "mask",
          "type": "uint32_t",
          "tags": [
            "default:4294967295"
          ],
          "doc": null
        },
        {
          "name": "attached",
          "type": "_Bool",
          "tags": [
            "idiom"
          ],
          "doc": "Whether the fixture has been attached to its body. Set by the plugin once the ancestor body exists; authoring it would claim a fixture the world does not have."
        }
      ]
    }
