<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Physics.Abstractions\KernelEngine.Physics.Abstractions.csproj" />
    <ProjectReference Include="..\..\common\KernelEngine.Common\KernelEngine.Common.csproj" />
    <ProjectReference Include="..\..\framework\KernelEngine.Framework\KernelEngine.Framework.csproj" /> <!-- CollisionShape2D : Node2D -->
    <ProjectReference Include="..\..\generators\KernelEngine.SourceGenerators\KernelEngine.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Body2DModule P/Invokes the reconciliation plugin directly; it is backend-agnostic,
         so it ships with the physics domain rather than with any one backend.
         Declared before the import: the copy items are built from @(NativeDep) at the
         import's own position, so a later declaration would be invisible to it. -->
    <NativeDep Include="ke_physics_body2d" />
  </ItemGroup>

  <Import Project="../../NativeDependencies.targets" />

</Project>
