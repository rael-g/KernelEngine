<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native-only carrier for ke_render_core.dll, the internal C++ render-pipeline shared library
    that ke_render_bgfx links against (target_link_libraries: ke_render_core). This assembly has no
    managed code; its sole job is to deploy ke_render_core.dll (and, via the ProjectReference, the
    ke_kernel/ke_threading DLLs it depends on) wherever a renderer plugin is referenced.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ke_render_core is a STATIC archive embedded inside ke_render_bgfx.dll, so there is no
         separate native target to deploy. This project remains only because downstream
         packages depend on it transitively; it ships zero native bytes. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
  </ItemGroup>

</Project>
