<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KernelEngine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Sdk\KernelEngine.Sdk.csproj" />
    <ProjectReference Include="..\..\ecs\KernelEngine.Ecs.Flecs\KernelEngine.Ecs.Flecs.csproj" />
    <ProjectReference Include="..\..\tasks\KernelEngine.Job.Enki\KernelEngine.Job.Enki.csproj" />
    <ProjectReference Include="..\..\tasks\KernelEngine.Async.Enki\KernelEngine.Async.Enki.csproj" />
    <ProjectReference Include="..\..\io\KernelEngine.FileSystem.Std\KernelEngine.FileSystem.Std.csproj" />
    <ProjectReference Include="..\..\io\KernelEngine.Io.Std\KernelEngine.Io.Std.csproj" />
    <ProjectReference Include="..\..\window\KernelEngine.Window.Glfw\KernelEngine.Window.Glfw.csproj" />
    <ProjectReference Include="..\..\render\KernelEngine.Render.Webgpu\KernelEngine.Render.Webgpu.csproj" />
    <ProjectReference Include="..\..\render\KernelEngine.RenderGraph.Simple\KernelEngine.RenderGraph.Simple.csproj" />
    <ProjectReference Include="..\..\physics\KernelEngine.Physics.Box2D\KernelEngine.Physics.Box2D.csproj" />
    <ProjectReference Include="..\..\audio\KernelEngine.Audio.MiniAudio\KernelEngine.Audio.MiniAudio.csproj" />
    <ProjectReference Include="..\..\asset\KernelEngine.Text.StbTrueType\KernelEngine.Text.StbTrueType.csproj" />
    <ProjectReference Include="..\..\assembly\KernelEngine.Assembly.Default\KernelEngine.Assembly.Default.csproj" />
    <ProjectReference Include="..\..\assembly\KernelEngine.Assembly.Toml\KernelEngine.Assembly.Toml.csproj" />
    <ProjectReference Include="..\..\framework\KernelEngine.Framework\KernelEngine.Framework.csproj" />
    <ProjectReference Include="..\..\input\KernelEngine.Input\KernelEngine.Input.csproj" />
    <ProjectReference Include="..\..\physics\KernelEngine.Physics\KernelEngine.Physics.csproj" />
    <ProjectReference Include="..\..\render\KernelEngine.Render.Frame\KernelEngine.Render.Frame.csproj" />
    <ProjectReference Include="..\..\audio\KernelEngine.Audio\KernelEngine.Audio.csproj" />
    <ProjectReference Include="..\..\render\KernelEngine.View\KernelEngine.View.csproj" />
    <ProjectReference Include="..\..\scheduling\KernelEngine.Runner.Window\KernelEngine.Runner.Window.csproj" />
    <ProjectReference Include="..\..\scheduling\KernelEngine.Runner.Headless\KernelEngine.Runner.Headless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../../build/native/bin/pong/assets/fonts/*" Link="assets/fonts/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../../build/native/bin/*.composition" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../../../build/native/bin/shaders/**" Link="shaders/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
