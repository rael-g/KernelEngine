<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native runtime plugin (flecs-backed IRuntime). All pointer interop is
         confined here; consumers see only the managed IRuntime contract from
         KernelEngine.Kernel.Abstractions. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KernelEngine.Runtime.Flecs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <NativeDep Include="ke_runtime_flecs" />
    <NativeDep Include="ke_kernel" />
  </ItemGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="KernelEngine.Runtime.Flecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel.Abstractions\KernelEngine.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
  </ItemGroup>

</Project>
