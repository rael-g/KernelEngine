    {
      "name": "ke_label_component",
      "doc": "A screen-space text label. Text/anchor/offset/color/font are the caller\u0027s input; glyph_count and glyphs[] are output, written each KE_PHASE_UPDATE tick by the \u0022render.ui.labels\u0022 system and read by \u0022render.ui\u0022 (KE_PHASE_RENDER) to draw them \u2014 the same sim-writes/render-reads split every other render component uses, so there is no per-glyph entity, no CPU-side accumulator, no pool to grow or reuse.",
      "tags": [
        "node:Label",
        "base:Node3D"
      ],
      "fields": [
        {
          "name": "font",
          "type": "char[128]",
          "tags": [],
          "doc": "Font file to draw with, baked by the \u0022render.label.resolve\u0022 system."
        },
        {
          "name": "font_size",
          "type": "float",
          "tags": [
            "default:32"
          ],
          "doc": null
        },
        {
          "name": "font_handle",
          "type": "ke_ui_font_handle",
          "tags": [
            "idiom",
            "name:font_handle"
          ],
          "doc": "Resolved from \u0060font\u0060."
        },
        {
          "name": "anchor",
          "type": "float[2]",
          "tags": [],
          "doc": "Anchor in normalized [0..1] of the backbuffer. (0,0) = top-left, (1,1) = bottom-right."
        },
        {
          "name": "offset",
          "type": "float[2]",
          "tags": [],
          "doc": "Pixel offset applied AFTER anchor positioning."
        },
        {
          "name": "color",
          "type": "float[4]",
          "tags": [
            "default:1 1 1 1"
          ],
          "doc": null
        },
        {
          "name": "text",
          "type": "char[256]",
          "tags": [],
          "doc": null
        },
        {
          "name": "glyph_count",
          "type": "uint32_t",
          "tags": [
            "idiom",
            "output"
          ],
          "doc": "Written by \u0022render.ui.labels\u0022; a node authoring it would have the value overwritten on the next tick."
        },
        {
          "name": "glyphs",
          "type": "ke_label_glyph_quad[256]",
          "tags": [
            "idiom",
            "output"
          ],
          "doc": "Shaped output, see glyph_count."
        }
      ]
