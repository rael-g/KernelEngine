            {
              "name": "pixel_size",
              "type": "float",
              "tags": [],
              "doc": null
            },
            {
              "name": "first_codepoint",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "codepoint_count",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "atlas_size",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_font",
              "type": "ke_font_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives a ke_font_data (atlas RGBA8 \u002B metrics) the caller releases via free_font; left NULL on failure."
            }
          ],
          "receiver": "struct ke_font_loader *"
        },
        {
          "name": "free_font",
