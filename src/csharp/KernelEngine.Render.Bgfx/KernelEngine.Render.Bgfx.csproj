<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTarget>ke_render_bgfx</NativeTarget>
  </PropertyGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <None Include="$(NativeFinalDir)\ke_shader_compiler_bgfx.$(NativeExt)" Condition="Exists('$(NativeFinalDir)\ke_shader_compiler_bgfx.$(NativeExt)')">
      <Link>ke_shader_compiler_bgfx.$(NativeExt)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
    <!-- ke_render_bgfx links the ke_render_core shared lib; this carries ke_render_core.dll. -->
    <ProjectReference Include="..\KernelEngine.Render.Core\KernelEngine.Render.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
