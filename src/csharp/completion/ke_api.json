    {
      "name": "ke_completion",
      "doc": "Work that finishes once, with a result: a job, an asynchronous operation, a read, a run, a submission. Whoever received it releases it exactly once; a completion that another call borrowed as a dependency is released only after the work that depends on it completed.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "poll",
          "returns": "_Bool",
          "tags": [],
          "doc": "Whether the work finished; callable from any thread.",
          "return_doc": "true once the work finished.",
          "params": [
            {
              "name": "out_result",
              "type": "ke_result *",
              "tags": [
                "out"
              ],
              "doc": "Receives what the work finished with, when it finished."
            }
          ],
          "receiver": "ke_completion *"
        },
        {
          "name": "wait",
          "returns": "ke_result",
          "tags": [],
          "doc": "Blocks until the work finishes and returns what it finished with. Callable from the thread that created the system the completion came from, and from inside a job when the completion came from that job system.",
          "return_doc": "What the work finished with; KE_RESULT_NOT_SUPPORTED, at once, from any other thread, where the completion is passed as a dependency instead.",
          "params": [],
          "receiver": "ke_completion *"
        },
        {
          "name": "release",
          "returns": "void",
          "tags": [],
          "doc": "Gives the completion back; the pointer is invalid afterwards. The work itself is not stopped.",
          "return_doc": null,
          "params": [],
          "receiver": "ke_completion *"
        }
      ]
    }
  ],
