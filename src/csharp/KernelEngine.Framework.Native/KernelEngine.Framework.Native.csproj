<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native backend assembly: unsafe pointer-pushing implementations of the
         IXxxBackend contracts from KernelEngine.Framework.Abstractions. Game code
         only touches the DI extension AddNativeFramework() from this assembly;
         everything else is internal. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KernelEngine.Framework</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <NativeDep Include="ke_framework" />
  </ItemGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="KernelEngine.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel.Abstractions\KernelEngine.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\KernelEngine.Framework.Abstractions\KernelEngine.Framework.Abstractions.csproj" />
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
    <ProjectReference Include="..\KernelEngine.Framework\KernelEngine.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
