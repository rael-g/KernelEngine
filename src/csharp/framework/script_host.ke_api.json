{
  "enums": [
    {
      "name": "ke_script_reach",
      "doc": "How far one instance\u0027s behaviour reaches, which is what decides whether the runtime may run a type\u0027s instances as concurrent slices.",
      "values": [
        {
          "name": "KE_SCRIPT_REACH_SELF",
          "value": 0,
          "doc": "Touches only the entity it is bound to. Two instances are two entities, so their work cannot overlap."
        },
        {
          "name": "KE_SCRIPT_REACH_ANY",
          "value": 1,
          "doc": "Reaches entities it was not handed \u2014 a borrow, a lookup by name, a query. Anything unproven belongs here."
        }
      ]
    },
    {
      "name": "ke_script_resolve",
      "doc": "Reports why a resolve answered the way it did.",
      "values": [
        {
          "name": "KE_SCRIPT_RESOLVE_FOUND",
          "value": 0,
          "doc": "Exactly one entity answered, and it is the one returned."
        },
        {
          "name": "KE_SCRIPT_RESOLVE_NONE",
          "value": 1,
          "doc": "Nothing answered. The borrow names a node that is not there."
        },
        {
          "name": "KE_SCRIPT_RESOLVE_AMBIGUOUS",
          "value": 2,
          "doc": "More than one answered, so none was returned."
        }
      ]
    },
    {
      "name": "ke_script_borrow",
      "doc": "Where a borrow looks for the node it names. A borrow is always an instance of a type, optionally with a name; only the region searched differs.",
      "values": [
        {
          "name": "KE_SCRIPT_BORROW_DESCENDANT",
          "value": 0,
          "doc": "Below the borrower, depth-first."
        },
        {
          "name": "KE_SCRIPT_BORROW_ANCESTOR",
          "value": 1,
          "doc": "The nearest above the borrower. This is the only reach that never answers ambiguous."
        },
        {
          "name": "KE_SCRIPT_BORROW_ANYWHERE",
          "value": 2,
          "doc": "Anywhere the type is bound, ignoring the borrower\u0027s position."
        }
      ],
      "tags": [
        "borrow_kinds"
      ]
    }
  ],
