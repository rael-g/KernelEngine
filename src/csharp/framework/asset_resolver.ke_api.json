          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_texture_data *",
              "tags": [],
              "doc": null
            }
          ]
        },
        {
          "name": "resolve_mesh",
          "returns": "_Bool",
          "tags": [],
          "doc": "Resolves a mesh path. Two shapes are supported today: \u0022res://primitives/{quad|plane|cube|sphere}\u0022 -\u003E baked primitive via ke_mesh_shape_bake (additional model-file extensions land when an asset loader is injected; .gltf/.fbx/.obj are not yet routed). Caller owns the result; release with free_mesh.",
          "return_doc": null,
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
