      "slots": [
        {
          "name": "resolve_texture",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves an image path into freshly-decoded RGBA8 pixel data. Caller owns the result; release with free_texture.",
          "return_doc": "KE_OK; KE_RESULT_NOT_FOUND when the file is missing or the extension is unsupported; KE_RESULT_INVALID_ARGUMENT when no image loader was injected at construction time; the image loader\u0027s code otherwise.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out",
              "type": "ke_texture_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the decoded texture data on success."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "free_texture",
          "returns": "void",
          "tags": [],
          "doc": null,
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_texture_data *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_mesh",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves a mesh path. \u0022res://primitives/{quad|plane|cube|sphere}\u0022 names a baked primitive, built via ke_mesh_shape_bake; a path that names none fails. Caller owns the result; release with free_mesh.",
          "return_doc": "KE_OK, KE_RESULT_NOT_FOUND for a path that names no primitive, or KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out",
              "type": "ke_mesh_shape_data *",
              "tags": [
                "out"
              ],
              "doc": "Receives the baked mesh vertex/index data on success."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "free_mesh",
          "returns": "void",
          "tags": [],
          "doc": null,
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_mesh_shape_data *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_material",
          "returns": "ke_result",
          "tags": [],
          "doc": "Parses a \u0060.material\u0060 TOML file into ke_material_spec. Texture fields stay as path strings \u2014 feed them back through resolve_texture to materialise.",
          "return_doc": "KE_OK; KE_RESULT_NOT_FOUND when the file cannot be opened; KE_RESULT_IO when it is not TOML or holds no material table.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out",
              "type": "ke_material_spec *",
              "tags": [
                "out"
              ],
              "doc": "Receives the parsed material spec on success."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_font",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves a font file path into a freshly-baked ke_font_data (atlas RGBA8 \u002B glyph metrics). Caller owns the result; release with free_font.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT when no font loader was injected at construction time; KE_RESULT_NOT_FOUND when the file is missing; the font loader\u0027s code otherwise.",
          "params": [
