              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out",
              "type": "ke_texture_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the decoded texture data on success."
            },
            {
              "name": "out_error",
              "type": "ke_error **",
              "tags": [],
              "doc": null
            }
          ]
        },
        {
          "name": "free_texture",
          "returns": "void",
