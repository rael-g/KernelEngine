              "name": "first_codepoint",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "codepoint_count",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "atlas_size",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "out",
              "type": "ke_font_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives the baked font atlas \u002B glyph metrics on success."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
