          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_texture_into",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves and uploads a texture, deduped by \u0060path\u0060. On a cache hit, nothing is decoded.",
          "return_doc": "KE_OK, resolve_texture\u0027s codes, or KE_RESULT_GENERAL when the upload fails.",
          "params": [
            {
              "name": "core",
              "type": "ke_render_service *",
              "tags": [
                "borrowed"
              ],
              "doc": "The render service to upload into."
            },
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out_texture",
              "type": "ke_texture_handle *",
              "tags": [
                "out"
              ],
              "doc": "Receives the texture; KE_TEXTURE_NONE on failure."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_mesh_into",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves and uploads a mesh, deduped by \u0060path\u0060. Resolution is that of resolve_mesh.",
          "return_doc": "KE_OK, resolve_mesh\u0027s codes, or KE_RESULT_GENERAL when the upload fails.",
          "params": [
            {
              "name": "core",
              "type": "ke_render_service *",
              "tags": [
                "borrowed"
              ],
              "doc": "The render service to upload into."
            },
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out_mesh",
              "type": "ke_mesh_handle *",
              "tags": [
                "out"
              ],
              "doc": "Receives the mesh; KE_MESH_NONE on failure."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_material_into",
          "returns": "ke_result",
          "tags": [],
          "doc": "Resolves a \u0060.material\u0060 file, resolving/uploading its albedo and normal textures (each deduped by their own path) and creating the material, deduped by \u0060path\u0060.",
          "return_doc": "KE_OK, the codes of resolve_material and resolve_texture, or KE_RESULT_GENERAL when an upload or the material creation fails.",
          "params": [
            {
              "name": "core",
              "type": "ke_render_service *",
              "tags": [
                "borrowed"
              ],
              "doc": "The render service to upload into."
            },
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out_material",
              "type": "ke_material_handle *",
              "tags": [
                "out"
              ],
              "doc": "Receives the material; KE_MATERIAL_NONE on failure."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        },
        {
          "name": "resolve_path",
          "returns": "ke_result",
          "tags": [],
          "doc": "Writes the file path \u0060path\u0060 names into \u0060out\u0060, terminated: a path that begins with \u0022res://\u0022 is joined to the project root the resolver was created with, or stands as its remainder when none was given; any other path is copied as written. Nothing checks that the file exists.",
          "return_doc": "KE_OK, or KE_RESULT_INVALID_ARGUMENT when the result and its terminator do not fit in \u0060capacity\u0060 bytes.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": null
            },
            {
              "name": "out",
              "type": "char *",
              "tags": [
                "out",
                "array_of:capacity"
              ],
              "doc": "Receives the resolved path."
            },
            {
              "name": "capacity",
              "type": "size_t",
              "tags": [],
              "doc": "Bytes \u0060out\u0060 holds."
            }
          ],
          "receiver": "struct ke_asset_resolver *"
        }
      ]
