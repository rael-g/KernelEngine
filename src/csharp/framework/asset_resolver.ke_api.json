  "vtables": [
    {
      "name": "ke_font_loader",
      "doc": "Decodes font files (TTF/OTF/\u2026) on the CPU. Async dispatch is the caller\u0027s concern.",
      "tags": [
        "interface"
      ],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "load_font",
          "returns": "ke_result",
          "tags": [],
          "doc": "Loads path and bakes a glyph atlas at pixel_size for the codepoint range [first_codepoint, first_codepoint \u002B codepoint_count).",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null path or out_font, a non-positive size, or a zero atlas size or codepoint count; KE_RESULT_IO when the file cannot be read; KE_RESULT_OUT_OF_MEMORY; KE_RESULT_GENERAL when the font cannot be packed.",
          "params": [
            {
              "name": "path",
              "type": "const char *",
              "tags": [
                "utf8"
              ],
              "doc": "TTF/OTF file path to decode."
            },
            {
              "name": "pixel_size",
              "type": "float",
              "tags": [],
              "doc": null
            },
            {
              "name": "first_codepoint",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "codepoint_count",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "atlas_size",
              "type": "uint32_t",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_font",
              "type": "ke_font_data **",
              "tags": [
                "out"
              ],
              "doc": "Receives a ke_font_data (atlas RGBA8 \u002B metrics) the caller releases via free_font; left NULL on failure."
            }
          ],
          "receiver": "struct ke_font_loader *"
        },
        {
          "name": "free_font",
          "returns": "void",
          "tags": [
            "releases:BakedFont"
          ],
          "doc": "Frees a ke_font_data previously returned by load_font. A null data is ignored.",
          "return_doc": null,
          "params": [
            {
              "name": "data",
              "type": "ke_font_data *",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_font_loader *"
        }
      ],
      "external": true
    },
