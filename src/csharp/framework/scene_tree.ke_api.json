  "vtables": [
    {
      "name": "ke_ecs",
      "doc": "Entity lifetime and component storage.",
      "tags": [],
      "fields": [
        {
          "name": "handle",
          "type": "void *",
          "tags": [],
          "doc": null
        }
      ],
      "slots": [
        {
          "name": "entity_create",
          "returns": "ke_result",
          "tags": [],
          "doc": "Creates a fresh entity with no components. Structural; single-threaded.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT when the backend refuses the call, its reason logged.",
          "params": [
            {
              "name": "out_entity",
              "type": "ke_entity *",
              "tags": [
                "out"
              ],
              "doc": "Receives the entity; the null entity on failure."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "entity_destroy",
          "returns": "ke_result",
          "tags": [],
          "doc": "Destroys an entity and all its components; an entity that is not alive is left alone. Structural; single-threaded.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for the null entity or when the backend refuses the call, its reason logged.",
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_register",
          "returns": "ke_result",
          "tags": [],
          "doc": "Registers a component type by name, or returns the existing id if already registered. A repeated name must describe the same size, alignment and layout as its first registration. With \u0060fields\u0060 the layouts are compared field by field; without them, only the size and the alignment are compared.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT when the params are missing, the alignment is not a power of two, or the type conflicts with the name\u0027s prior registration, what disagrees being logged; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "params",
              "type": "const ke_component_params *",
              "tags": [
                "borrowed"
              ],
              "doc": "The name, size, alignment and field table of the type."
            },
            {
              "name": "out_cid",
              "type": "ke_component_id *",
              "tags": [
                "out"
              ],
              "doc": "Receives the component\u0027s id; KE_COMPONENT_INVALID on failure."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_lookup",
          "returns": "_Bool",
          "tags": [
            "try"
          ],
          "doc": "Looks up a previously registered component by name.",
          "return_doc": "false if no component of that name is registered.",
          "params": [
            {
              "name": "name",
              "type": "const char *",
              "tags": [
                "borrowed",
                "utf8"
              ],
              "doc": "Component name to find."
            },
            {
              "name": "out_meta",
              "type": "ke_component_meta *",
              "tags": [
                "out"
              ],
              "doc": "Receives the component\u0027s id, size, and field metadata."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_add",
          "returns": "ke_result",
          "tags": [],
          "doc": "Attaches a component to an entity: its storage is zeroed, then seeded with the defaults of the field table the component was registered with, on the first attach; an entity that already has the component keeps its storage unchanged. Structural; single-threaded.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for an entity that is not alive, the null entity or component, or when the backend refuses the call, its reason logged.",
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            },
            {
              "name": "component",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_data",
              "type": "void **",
              "tags": [
                "out"
              ],
              "doc": "Receives the storage, valid until the next structural change on this ecs; NULL for a tag, and on failure."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_remove",
          "returns": "ke_result",
          "tags": [],
          "doc": "Detaches a component from an entity; an entity that is not alive is left alone. Structural; single-threaded.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for the null entity or component, or when the backend refuses the call, its reason logged.",
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            },
            {
              "name": "component",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_get",
          "returns": "void *",
          "tags": [],
          "doc": "Returns an entity\u0027s component storage, or NULL if it doesn\u0027t have that component. The pointer is valid until the next structural change on this ecs.",
          "return_doc": null,
          "params": [
            {
              "name": "entity",
              "type": "ke_entity",
              "tags": [],
              "doc": null
            },
            {
              "name": "component",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_size",
          "returns": "size_t",
          "tags": [],
          "doc": "Byte size of a registered component\u0027s element; 0 for a tag or unknown cid.",
          "return_doc": null,
          "params": [
            {
              "name": "cid",
              "type": "ke_component_id",
              "tags": [],
              "doc": null
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "component_field_write",
          "returns": "ke_result",
          "tags": [],
          "doc": "Writes value into component at the place field describes, converted to the field\u0027s type: an integer and a float convert to each other, a boolean to an integer, and a vector widens or narrows to the field\u0027s width; a string is cut to the field\u0027s size and stays NUL-terminated.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for a null argument, or for a value that does not convert to the field\u0027s type or a size the type cannot have, writing nothing.",
          "params": [
            {
              "name": "component",
              "type": "void *",
              "tags": [
                "borrowed"
              ],
              "doc": "The component\u0027s memory."
            },
            {
              "name": "field",
              "type": "const ke_component_field *",
              "tags": [
                "borrowed"
              ],
              "doc": "Where in the component, and of which type and size."
            },
            {
              "name": "value",
              "type": "const ke_variant *",
              "tags": [
                "borrowed"
              ],
              "doc": "The value to write."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "query_register",
          "returns": "ke_result",
          "tags": [],
          "doc": "Registers a query over a component tuple (entities matching ALL cids).",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for an empty tuple, one with more terms than the backend\u0027s queries hold, or one the backend refuses, its reason logged; KE_RESULT_OUT_OF_MEMORY.",
          "params": [
            {
              "name": "cids",
              "type": "const ke_component_id *",
              "tags": [
                "borrowed",
                "array_of:cid_count"
              ],
              "doc": "Component tuple to match."
            },
            {
              "name": "cid_count",
              "type": "size_t",
              "tags": [],
              "doc": "Number of components in the tuple."
            },
            {
              "name": "out_query",
              "type": "ke_query_id *",
              "tags": [
                "out"
              ],
              "doc": "Receives the query; KE_QUERY_INVALID on failure."
            }
          ],
          "receiver": "struct ke_ecs *"
        },
        {
          "name": "query_resolve",
          "returns": "ke_result",
          "tags": [
            "raw"
          ],
          "doc": "Resolves a query into archetype segments. MUST run single-threaded, before a parallel wave; afterwards the segments are plain memory touching no backend state.",
          "return_doc": "KE_OK; KE_RESULT_INVALID_ARGUMENT for an unknown query, missing output arrays or a zero capacity, or when the backend refuses the call, its reason logged.",
          "params": [
            {
              "name": "query",
              "type": "ke_query_id",
              "tags": [],
              "doc": null
            },
            {
              "name": "out_segments",
              "type": "ke_ecs_segment *",
              "tags": [
                "out",
                "array_of:max_segments"
              ],
              "doc": "Receives the matched segments."
            },
            {
              "name": "max_segments",
              "type": "size_t",
              "tags": [],
              "doc": "Capacity of out_segments."
            },
            {
              "name": "out_columns",
              "type": "void **",
              "tags": [
                "out"
              ],
              "doc": "Backing store of the segments\u0027 columns: segment i\u0027s columns are the cid_count entries starting at index i * cid_count, cid_count being the length of the tuple the query was registered with."
            },
            {
              "name": "out_count",
