      "slots": [
        {
          "name": "load",
          "returns": "ke_result",
          "tags": [],
          "doc": "Replaces every action with those of a TOML input file. An action type other than Button, Axis1D, Axis2D or Axis3D, a binding of an unknown kind, a binding missing a field, and a key or mouse button name the engine does not know each fail the load, as an invalid argument, logging the action and the binding; a load that fails leaves no actions. A file that cannot be opened fails as not found and one that does not parse as KE_RESULT_IO.",
          "return_doc": null,
          "params": [
