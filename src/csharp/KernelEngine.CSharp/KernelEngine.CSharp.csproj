<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- C# plugin. The "never references Framework" rule was relaxed by the
         2026-06-02 kernel/framework split: framework concept wrappers (e.g.
         NodeTypeRegistry) now live in KernelEngine.Framework, so this plugin's
         AddCSharpPlugin() DI extension must reach them. -->
    <ProjectReference Include="..\KernelEngine.Kernel\KernelEngine.Kernel.csproj" />
    <ProjectReference Include="..\KernelEngine.Framework\KernelEngine.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
