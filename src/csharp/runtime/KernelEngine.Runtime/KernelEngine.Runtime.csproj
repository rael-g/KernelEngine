<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- In-house scheduler. Wraps the ke_runtime vtable via ke_runtime_create.
         Takes an injected ke_ecs* (the storage plugin, e.g. KernelEngine.Ecs.Flecs)
         at construction. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KernelEngine.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <NativeDep Include="ke_runtime" />
    <NativeDep Include="ke_kernel" />
  </ItemGroup>

  <Import Project="../../NativeDependencies.targets" />

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Runtime.Abstractions\KernelEngine.Runtime.Abstractions.csproj" />
    <ProjectReference Include="..\..\common\KernelEngine.Common\KernelEngine.Common.csproj" />
    <ProjectReference Include="..\..\task_scheduler\KernelEngine.TaskScheduler\KernelEngine.TaskScheduler.csproj" />
    <ProjectReference Include="..\..\ecs\KernelEngine.Ecs\KernelEngine.Ecs.csproj" />
    <ProjectReference Include="..\..\ecs\KernelEngine.Ecs.Flecs\KernelEngine.Ecs.Flecs.csproj" />
  </ItemGroup>

</Project>
