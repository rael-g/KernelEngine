<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <NativeDep Include="ke_kernel" />
    <NativeDep Include="ke_threading" />
  </ItemGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <!-- Native pointers are public on wrappers; plugin assemblies don't need internal access.
         Framework references only Abstractions (not Kernel), so it gets no InternalsVisibleTo.
         Tests keep it for white-box assertions. -->
    <InternalsVisibleTo Include="KernelEngine.Kernel.Tests" />
    <InternalsVisibleTo Include="KernelEngine.Framework.Legacy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel.Abstractions\KernelEngine.Kernel.Abstractions.csproj" />
    <ProjectReference Include="..\KernelEngine.Configuration\KernelEngine.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
