<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTarget>ke_kernel</NativeTarget>
  </PropertyGroup>

  <Import Project="../NativeDependencies.targets" />

  <ItemGroup>
    <None Include="$(NativeFinalDir)\ke_threading.$(NativeExt)" Condition="Exists('$(NativeFinalDir)\ke_threading.$(NativeExt)')">
      <Link>ke_threading.$(NativeExt)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KernelEngine.Kernel.Tests" />
    <!-- Phase 1 of Bug 1.43: plugin assemblies still need raw pointer access to wire their factories.
         Phase 2 will replace each leak with a managed method on the owning wrapper and revoke these. -->
    <InternalsVisibleTo Include="KernelEngine.Framework" />
    <InternalsVisibleTo Include="KernelEngine.Asset.Assimp" />
    <InternalsVisibleTo Include="KernelEngine.DevPlatform.Win32" />
    <InternalsVisibleTo Include="KernelEngine.Logging.Serilog" />
    <InternalsVisibleTo Include="KernelEngine.Render.Bgfx" />
    <InternalsVisibleTo Include="KernelEngine.TaskScheduler.Enki" />
    <InternalsVisibleTo Include="KernelEngine.Window.Glfw" />
    <InternalsVisibleTo Include="KernelEngine.Framework.Tests" />
    <InternalsVisibleTo Include="KernelEngine.Logging.Serilog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernelEngine.Kernel.Abstractions\KernelEngine.Kernel.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
